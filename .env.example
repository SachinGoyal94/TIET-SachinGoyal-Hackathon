# Financial Risk Intelligence Platform — optional environment overrides.
# The platform runs with NO API KEYS on the default path; every knob below
# has a sensible default. Copy to .env only if you want to change something.

# --- Scheduler cadence (minutes) ------------------------------------------
#RISK_GDELT_POLL_MINUTES=15
#RISK_SYNTHETIC_FEED_MINUTES=5
#RISK_REBALANCE_MINUTES=5

# --- Storage ---------------------------------------------------------------
#RISK_DB_PATH=data/db/risk.db

# --- Models (HuggingFace ids; weights are baked into the Docker image) ----
#RISK_SENTIMENT_MODEL=ProsusAI/finbert
#RISK_EVENT_MODEL=typeform/distilbert-base-uncased-mnli

# --- Optional extra live news source (off by default) ----------------------
#NEWSAPI_KEY=
